rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    // ============================================================
    // AI BullyShield — Firestore Security Rules
    // ============================================================
    
    // Helper: Check if the user is authenticated
    function isAuthenticated() {
      return request.auth != null;
    }
    
    // Helper: Check if the user has counselor role
    function isCounselor() {
      return isAuthenticated() && 
             request.auth.token.role in ['counselor', 'admin'];
    }
    
    // Helper: Check if the user is an admin
    function isAdmin() {
      return isAuthenticated() && 
             request.auth.token.role == 'admin';
    }
    
    // Helper: Validate report fields
    function isValidReport() {
      let data = request.resource.data;
      return data.keys().hasAll(['category', 'riskLevel', 'description', 'status', 'isAnonymous'])
        && data.category in ['cyberbullying', 'harassment', 'threat', 'abusive_language', 'discrimination', 'self_harm', 'safe', 'uncertain']
        && data.riskLevel in ['none', 'low', 'medium', 'high']
        && data.description is string
        && data.description.size() >= 10
        && data.description.size() <= 5000
        && data.status in ['submitted', 'under_review', 'assigned', 'resolved', 'closed']
        && data.isAnonymous is bool;
    }
    
    // Reports collection
    match /reports/{reportId} {
      // No public read access — only counselors and admins can read reports
      allow read: if isCounselor();
      
      // Anyone can create a report (including anonymous users via the API)
      // But the report must be validated
      allow create: if isValidReport()
                    && request.resource.data.status == 'submitted';
      
      // Only counselors can update reports (status, notes, assignment)
      allow update: if isCounselor()
                    && request.resource.data.category == resource.data.category
                    && request.resource.data.description == resource.data.description;
      
      // Only admins can delete reports
      allow delete: if isAdmin();
    }
    
    // Counselor profiles
    match /counselors/{counselorId} {
      // Counselors can read their own profile
      allow read: if isAuthenticated() && request.auth.uid == counselorId;
      
      // Admins can read all counselor profiles
      allow read: if isAdmin();
      
      // Only admins can create/update/delete counselor profiles
      allow write: if isAdmin();
    }
    
    // User settings (extension settings, stored per user)
    match /userSettings/{userId} {
      // Users can only read/write their own settings
      allow read, write: if isAuthenticated() && request.auth.uid == userId;
    }
    
    // Deny everything else by default
    match /{document=**} {
      allow read, write: if false;
    }
  }
}
