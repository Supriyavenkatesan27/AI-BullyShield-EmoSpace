# =============================================================
# AI BullyShield — Environment Variables
# =============================================================
# Copy this file to .env and fill in your values.
# NEVER commit the .env file to version control.
# =============================================================

# --- Google Gemini API ---
# Get your API key from: https://aistudio.google.com/apikey
GEMINI_API_KEY=

# --- Firebase Configuration ---
# Get these from: https://console.firebase.google.com → Project Settings → General
VITE_FIREBASE_API_KEY=
VITE_FIREBASE_AUTH_DOMAIN=
VITE_FIREBASE_PROJECT_ID=
FIREBASE_PROJECT_ID=
VITE_FIREBASE_STORAGE_BUCKET=
VITE_FIREBASE_MESSAGING_SENDER_ID=
VITE_FIREBASE_APP_ID=

# --- API Server ---
API_PORT=
API_HOST=
VITE_API_URL=

# --- Mode ---
# Set to "demo" to use deterministic local analysis without Gemini API
# Set to "live" to use real Gemini API (requires GEMINI_API_KEY)
AI_MODE=

# --- Firebase Admin SDK (live report persistence) ---
# Use Application Default Credentials on a hosted runtime, or point to a
# service account JSON kept outside version control on your own machine.
FIREBASE_SERVICE_ACCOUNT_PATH=

# --- Browser origins allowed to call the API ---
# Local-development default. For a deployment, set the exact extension ID and dashboard origin.
CORS_ORIGINS=

# --- Rate Limiting ---
RATE_LIMIT_WINDOW_MS=
RATE_LIMIT_MAX_REQUESTS=
